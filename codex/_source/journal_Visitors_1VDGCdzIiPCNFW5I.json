    {
      "_id": "Bz3JUK7BUM2PPt87",
      "name": "Merchants",
      "type": "dxcufgbs-player-bastions.inhabitant",
      "sort": 200000,
      "title": {
        "show": false,
        "level": 1
      },
      "system": {
        "ref": "merchants",
        "category": "visitors",
        "image": "modules/dxcufgbs-player-bastions/assets/codex/merchants.webp",
        "icon": "modules/dxcufgbs-player-bastions/assets/codex/icons/merchants.webp",
        "description": "<p>Peddlers, caravans, merchant companies and the occasional exotic trader who stop at the Bastion to sell their wares.</p><p>How often they come and how rich their stock is depends on Accessibility, Prosperity, Renown and the Bastion's trade buildings. While a merchant is visiting, the owners can buy from the Trade page.</p>"
