    {
      "_id": "fiByIVsNU2SB7f19",
      "name": "Brickworks",
      "type": "dxcufgbs-player-bastions.facility",
      "sort": 200000,
      "title": {
        "show": false,
        "level": 1
      },
      "system": {
        "ref": "brickworks",
