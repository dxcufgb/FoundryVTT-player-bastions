{{!-- One building on the Facilities page (bastion-sheet.hbs): this module's building or a dnd5e facility. --}}
<li class="dxpb-fac {{#if building}}building{{/if}} {{#if damaged}}damaged{{/if}} {{#if system}}dxpb-fac-system{{/if}}"
    {{#if fid}}data-fid="{{fid}}"{{/if}} {{#if uuid}}data-uuid="{{uuid}}"{{/if}} {{#if img}}style="--underlay: url('{{img}}')"{{/if}}>
  <a class="dxpb-fac-name" data-action="{{open.action}}" {{#if open.tab}}data-tab="{{open.tab}}"{{/if}} {{#if uuid}}data-uuid="{{uuid}}"{{/if}}>
    <span class="title">{{name}}</span>{{#if subtitle}}<span class="subtitle">{{subtitle}}</span>{{/if}}
  </a>
  <span class="dxpb-fac-slots">
    {{#if upgrade}}{{#if upgrade.action}}<button type="button" class="dxpb-fac-up" data-action="{{upgrade.action}}" {{#if upgrade.kind}}data-kind="{{upgrade.kind}}"{{/if}}
      {{#if fid}}data-fid="{{fid}}"{{/if}} {{#if upgrade.id}}data-id="{{upgrade.id}}"{{/if}} data-tooltip="{{upgrade.tip}}" aria-label="{{upgrade.tip}}"><i class="fa-solid fa-angles-up" inert></i></button>
    {{else}}<span class="dxpb-fac-up" data-tooltip="{{upgrade.tip}}" aria-label="{{upgrade.tip}}"><i class="fa-solid fa-angles-up" inert></i></span>{{/if}}{{/if}}
    {{#if repair}}<button type="button" class="dxpb-fac-repair" data-action="featureProject" data-kind="repair" data-fid="{{fid}}" data-tooltip="{{localize 'DXPB.Repair'}}" aria-label="{{localize 'DXPB.Repair'}}"><i class="fa-solid fa-screwdriver-wrench" inert></i></button>{{/if}}
    {{#if use}}<button type="button" class="dxpb-fac-use" data-action="useFacility" data-tooltip="{{use}}" aria-label="{{use}}"><i class="fa-solid fa-scroll" inert></i></button>{{/if}}
    {{#if orderIcon}}<span class="dxpb-fac-icon dxpb-fac-order"><dnd5e-icon src="{{orderIcon}}"></dnd5e-icon></span>
    {{else}}<span class="dxpb-fac-icon"><i class="fa-solid {{icon}}" inert></i></span>{{/if}}
  </span>
  {{#if progress}}<span class="dxpb-fac-progress" style="width: {{progress.pct}}%"></span>{{/if}}
</li>
